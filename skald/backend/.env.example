# Gabarit d'environnement — backend Skald.
# Copier en .env.local (gitignoré) et compléter pour le dev local.
# Le déploiement Homelab utilise son propre .env généré sur Thor
# (cf. HOMELAB/_SERVICES/api.skald.phracktale.com/).

APP_ENV=dev
# openssl rand -hex 16
APP_SECRET=change-me

# Base de données (doit correspondre aux variables du service `database`).
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=ChangeMe

# Caddy/FrankenPHP : nom de domaine servi (localhost en dev, TLS interne).
SERVER_NAME=localhost
