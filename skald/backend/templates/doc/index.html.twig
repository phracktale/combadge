{% extends 'base.html.twig' %}

{% block title %}Documentation développeur — Skald{% endblock %}

{% block body %}
<section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-semibold">Documentation développeur</h1>
    <p class="mt-3 text-slate-400">
        Rendue directement depuis les fichiers Markdown du dépôt (source
        unique). Le détail vit sur
        <a class="underline hover:text-slate-200" href="{{ github_url }}" target="_blank" rel="noopener noreferrer">GitHub</a>.
    </p>
    <ul class="mt-8 space-y-3">
        {% for slug, title in pages %}
        <li>
            <a class="block rounded-lg border border-white/10 bg-slate-900/60 px-4 py-3 transition-colors hover:border-indigo-500/50 hover:bg-slate-900"
               href="{{ path('app_doc_page', {slug: slug}) }}">{{ title }}</a>
        </li>
        {% endfor %}
    </ul>
</section>
{% endblock %}
