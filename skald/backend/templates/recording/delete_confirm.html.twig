{% extends 'base.html.twig' %}

{% block title %}Confirmer la suppression — Skald{% endblock %}

{% block body %}
<section class="mx-auto max-w-2xl px-4 py-12">
    <h1 tabindex="-1" class="text-2xl font-semibold text-rose-300">Confirmer la suppression</h1>
    <p class="mt-3 text-slate-300">
        Cette action est <strong>irréversible</strong> : les fichiers audio et
        leurs métadonnées seront définitivement supprimés.
        {{ recordings|length }} enregistrement(s) concerné(s) :
    </p>

    <ul class="mt-4 space-y-1 text-sm text-slate-300">
        {% for r in recordings %}
        <li class="rounded border border-white/10 bg-slate-900/60 px-3 py-2">
            {{ r.uploadedAt|date('d/m/Y H:i:s', 'Europe/Paris') }}
            — {{ r.originalFilename }} ({{ (r.sizeBytes / 1024)|round }} ko)
        </li>
        {% endfor %}
    </ul>

    <form method="post" action="{{ path('app_recordings_delete_confirm') }}" class="mt-6 flex items-center gap-4">
        {% for r in recordings %}
            <input type="hidden" name="ids[]" value="{{ r.id }}">
        {% endfor %}
        <input type="hidden" name="_token" value="{{ csrf_token('delete_recordings') }}">
        <button type="submit"
                class="rounded-md bg-rose-700 px-4 py-2 font-medium transition-colors hover:bg-rose-600 focus:outline-none focus:ring-2 focus:ring-rose-400">
            Confirmer la suppression
        </button>
        <a href="{{ path('app_recordings') }}" class="rounded-md border border-white/15 px-4 py-2 hover:bg-white/5">Annuler</a>
    </form>
</section>
{% endblock %}

{% block javascripts %}
<script>document.querySelector('h1') && document.querySelector('h1').focus();</script>
{% endblock %}
